        "updated_at": "timestamptz"
      },
      "constraints": [
        "max_score > 0",
        "student_count >= 0",
        "mastery_threshold_pct between 0 and 100",
        "mastered_count/near_mastery_count/intervention_count >= 0",
        "mastered_count + near_mastery_count + intervention_count <= student_count",
        "average/highest/lowest <= max_score when present",
        "average/highest/lowest >= 0 when present",
        "status in draft/recorded/reviewed"
      ]
