{
  "contract_version": "1.0.0",
  "phase": "S2-A",
  "project_version": "0.16.0",
  "source": {
    "engine": "SQLite",
    "legacy_table_count": 25,
    "runtime": "FastAPI/SQLite"
  },
  "target": {
    "engine": "PostgreSQL via Supabase",
    "target_table_count": 26,
    "runtime_switch_allowed": false,
    "sql_migrations_allowed": false,
    "primary_key_policy": {
      "auth_bound": "uuid",
      "tenant_root": "schools.id uuid",
      "domain_entities": "bigint generated by default as identity",
      "reason": "preserve numeric domain IDs and TypeScript/API parity while using UUID for auth/tenant roots"
    },
    "tenant_policy": {
      "tenant_key": "school_id",
      "rule": "all tenant-owned public tables carry school_id directly; profiles is the only public identity table without school_id",
      "cross_tenant_fk_rule": "tenant-owned foreign keys must be school-scoped where practical using composite FK pairs",
      "rls_basis": "school_memberships",
      "v1_access_scope": "school is the tenant boundary; subject/department is domain data, not a separate security tenant in schema v1"
    },
    "academic_year_policy": {
      "table": "academic_years",
      "label_format": "YYYY/YYYY",
      "no_invented_term_dates": true,
      "year_scoped_tables": [
        "teacher_years",
        "upload_requests",
        "documents",
        "events",
        "meetings",
        "curriculum_plans",
        "supervision_visits",
        "achievement_assessments"
      ],
      "nullable_year_tables": [
        "activities"
      ],
      "legacy_fallback_policy": {
        "explicit_year_wins": true,
        "event_without_explicit_year": "preserve current legacy compatibility: derive YYYY/YYYY from event_date using existing August cutoff and flag as inferred in migration report",
        "request_without_explicit_year": "preserve current legacy compatibility: derive YYYY/YYYY from created_at using existing August cutoff and flag as inferred in migration report",
        "document_without_explicit_year": "derive from uploaded_at using the same legacy compatibility rule and flag as inferred in migration report",
        "no_new_oman_term_boundaries": true
      },
      "teacher_year_membership_source": "union of explicit teacher_record_years and teachers referenced by year-scoped operational records, matching current archive/search linkage; annual attributes remain null unless source proves them"
    },
    "time_policy": {
      "timestamps": "timestamptz",
      "calendar_dates": "date",
      "clock_times": "time without time zone",
      "metric_measurement_date": "achievement_action_metrics.measured_at uses date"
    },
    "security_design": {
      "roles": [
        "owner",
        "admin",
        "lead_teacher",
        "teacher",
        "viewer"
      ],
      "membership_statuses": [
        "active",
        "invited",
        "suspended"
      ],
      "secret_rule": "no OAuth refresh token, service-role key, or provider secret in public tables",
      "auth_profile_rule": "profiles.id references auth.users(id) on delete cascade",
      "rls_implementation_phase": "S2-C",
      "teacher_account_link": "school_memberships.teacher_id nullable -> teachers.id within same school"
    },
    "storage_design": {
      "primary_provider": "supabase",
      "metadata_only_in_database": true,
      "provider_values": [
        "supabase",
        "google_drive",
        "legacy_local"
      ],
      "required_metadata": [
        "storage_provider",
        "storage_bucket",
        "storage_path"
      ],
      "legacy_external_link_supported": true,
      "storage_policies_phase": "later storage vertical slice"
    },
    "index_policy": {
      "index_all_foreign_keys": true,
      "index_rls_membership_keys": true,
      "partial_unique_current_academic_year_per_school": true,
      "partial_unique_event_cover": true
    }
  },
  "tables": [
